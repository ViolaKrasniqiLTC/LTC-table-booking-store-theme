{% comment %}
  Table Availability Grid
  - Reads Booking metaobject entries directly
  - Two tabs: this week's bookings + next week availability (Mon–Fri)
  - A day is "Taken" if a Booking exists for that table+date with
    status Booked or Completed. Cancelled bookings free the day up again.
  - Product booking links only appear on the next-week tab.
{% endcomment %}

{{ 'table-availability.css' | asset_url | stylesheet_tag }}
<script src="{{ 'table-availability.js' | asset_url }}" defer="defer"></script>

{% assign offset_seconds = 'now' | date: '%u' | minus: 1 | times: 86400 %}
{% assign this_monday_ts = 'now' | date: '%s' | minus: offset_seconds %}
{% assign next_monday_ts = this_monday_ts | plus: 604800 %}

{% paginate shop.metaobjects.booking.values by 250 %}
  {% capture taken_keys %}
    {% for booking in shop.metaobjects.booking.values %}
      {% unless booking.status.value == 'Cancelled' %}
        {% if booking.table.value.handle != blank %}
          |{{ booking.table.value.handle }}_{{ booking.date.value | date: '%Y-%m-%d' }}|
        {% elsif booking.table.value.id != blank %}
          |id:{{ booking.table.value.id }}_{{ booking.date.value | date: '%Y-%m-%d' }}|
        {% endif %}
      {% endunless %}
    {% endfor %}
  {% endcapture %}
{% endpaginate %}

<div class="table-availability" style="--avail-max-width: {{ section.settings.max_width }}px;">
  <div class="table-availability__tabs" role="tablist" aria-label="Availability weeks">
    <button
      type="button"
      class="table-availability__tab"
      role="tab"
      id="table-availability-tab-this-week"
      aria-controls="table-availability-panel-this-week"
      aria-selected="false"
      tabindex="-1"
      data-week="this"
    >
      This week's bookings
    </button>
    <button
      type="button"
      class="table-availability__tab table-availability__tab--active"
      role="tab"
      id="table-availability-tab-next-week"
      aria-controls="table-availability-panel-next-week"
      aria-selected="true"
      tabindex="0"
      data-week="next"
    >
      Next week availability
    </button>
  </div>

  <div
    class="table-availability__panel"
    role="tabpanel"
    id="table-availability-panel-this-week"
    aria-labelledby="table-availability-tab-this-week"
    hidden
  >
    {% render 'table-availability-grid',
      monday_ts: this_monday_ts,
      taken_keys: taken_keys,
      table_blocks: section.blocks
    %}
  </div>

  <div
    class="table-availability__panel table-availability__panel--active"
    role="tabpanel"
    id="table-availability-panel-next-week"
    aria-labelledby="table-availability-tab-next-week"
  >
    {% render 'table-availability-grid',
      monday_ts: next_monday_ts,
      taken_keys: taken_keys,
      allow_booking_links: true,
      include_editor_attrs: true,
      table_blocks: section.blocks
    %}
  </div>

  <div class="table-availability__legend">
    <span class="table-availability__legend-item table-availability__legend-item--available">✓ Available</span>
    <span class="table-availability__legend-item table-availability__legend-item--taken">✗ Taken</span>
  </div>
</div>

{% schema %}
{
  "name": "Table availability",
  "tag": "section",
  "class": "section-table-availability",
  "settings": [
    { "type": "range", "id": "max_width", "label": "Maximum width (px)", "min": 600, "max": 1400, "step": 20, "default": 1200 }
  ],
  "blocks": [
    {
      "type": "table",
      "name": "Table",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Must match the Table field on your Booking metaobject entries" },
        { "type": "text", "id": "label", "label": "Label override", "info": "Defaults to the product title" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Table availability",
      "blocks": [
        { "type": "table" }, { "type": "table" }, { "type": "table" }, { "type": "table" },
        { "type": "table" }, { "type": "table" }, { "type": "table" }, { "type": "table" }
      ]
    }
  ]
}
{% endschema %}
